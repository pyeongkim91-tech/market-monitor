import os, logging
from io import StringIO
from datetime import datetime, timezone, timedelta
from functools import lru_cache
import json, pathlib

import numpy as np
import pandas as pd
import yfinance as yf
from pandas_datareader import data as pdr
import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry
from bs4 import BeautifulSoup
from pandas.tseries.offsets import BDay

# ===== 기본 =====
START = "2019-01-01"
SMA_WIN = 200
W4 = 20

US_EQW, US_CAP = "RSP", "VOO"
KR_EQW, KR_CAP = "252000.KS", "069500.KS"
KOSPI, KOSDAQ, VIX = "^KS11", "^KQ11", "^VIX"

logging.basicConfig(level=logging.INFO)
CACHE_DIR = pathlib.Path.home() / "cache"
CACHE_DIR.mkdir(parents=True, exist_ok=True)

# ===== HTTP 세션 =====
_session = None
def _sess():
    global _session
    if _session is None:
        s = requests.Session()
        retry = Retry(total=5, backoff_factor=1.0,
                      status_forcelist=[429,500,502,503,504],
                      allowed_methods=["GET"])
        ad = HTTPAdapter(max_retries=retry)
        s.mount("https://", ad); s.mount("http://", ad)
        s.headers.update({"User-Agent":"Mozilla/5.0","Accept-Language":"en-US,en;q=0.9,ko;q=0.8"})
        _session = s
    return _session

def _http_get(url:str)->str:
    r = _sess().get(url, timeout=20)
    r.raise_for_status()
    return r.text

def _pct(x): 
    try: return f"{x*100:.1f}%"
    except: return "N/A"

def pct_change_4w(s: pd.Series):
    try:
        s = s.dropna()
        if s.empty: return np.nan
        # 최근 날짜 기준 영업일 20일 전 “가장 가까운” 지점
        t0 = s.index[-1]
        t1 = t0 - BDay(W4)
        j = s.index.get_indexer([t1], method="nearest")[0]
        return s.iloc[-1] / s.iloc[j] - 1.0
    except Exception:
        return np.nan

def yf_close_series(ticker, start=START):
    try:
        df = yf.download(ticker, start=start, progress=False, group_by="ticker",
                         threads=False, auto_adjust=False, interval="1d")
        if isinstance(df, pd.DataFrame):
            if "Adj Close" in df: s = df["Adj Close"]
            elif "Close" in df:   s = df["Close"]
            else: return pd.Series(dtype="float64")
            if isinstance(s, pd.DataFrame): s = s.iloc[:,0]
            return s.dropna()
    except Exception as e:
        logging.warning(f"yf_close_series fail {ticker}: {e}")
    return pd.Series(dtype="float64")

def normalize_yield_pct(s: pd.Series)->pd.Series:
    s = s.dropna()
    if s.empty: return s
    # ^TNX, ^UST2Y가 10배 스케일로 올 때 교정
    return s/10.0 if s.iloc[-1] > 20.0 else s

def first_non_empty(*series: pd.Series)->pd.Series:
    for s in series:
        if isinstance(s, pd.Series) and not s.dropna().empty:
            return s.dropna()
    return pd.Series(dtype="float64")

# ===== FRED =====
def fred(series_id, start=START):
    try:
        s = pdr.DataReader(series_id, "fred", start=start)
        if isinstance(s, pd.DataFrame) and s.shape[1]==1: s = s.iloc[:,0]
        return s.dropna()
    except Exception as e:
        logging.warning(f"FRED fail {series_id}: {e}")
        return pd.Series(dtype="float64")

# ===== 종목 =====
@lru_cache(maxsize=1)
def get_sp500_tickers():
    cache = CACHE_DIR/"sp500.json"
    # 1) 캐시 우선
    if cache.exists():
        try:
            return json.loads(cache.read_text())
        except: pass
    # 2) 위키 시도
    urls = [
        "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies",
        "https://en.wikipedia.org/wiki/List_of_S&P_500_companies",
    ]
    for url in urls:
        try:
            html = _http_get(url)
            soup = BeautifulSoup(html, "html.parser")
            table = soup.find("table", {"id": "constituents"}) or soup.find("table")
            if not table: continue
            df = pd.read_html(StringIO(str(table)))[0]
            col = "Symbol" if "Symbol" in df.columns else ("Ticker symbol" if "Ticker symbol" in df.columns else None)
            if not col: continue
            syms = df[col].astype(str).str.strip().str.replace(".", "-", regex=False).tolist()
            if syms:
                cache.write_text(json.dumps(syms))
                return syms
        except Exception as e:
            logging.warning(f"S&P500 fetch fail: {e}")
    # 3) 마지막 보루: 빈 리스트
    return []

def _norm_kr_code(s):
    if not isinstance(s,str): return s
    s=s.strip()
    if s.endswith((".KS",".KQ")): return s
    if s.isdigit() and len(s)==6: return s+".KS"
    return s

@lru_cache(maxsize=1)
def get_kospi200_tickers():
    cache = CACHE_DIR/"kospi200.json"
    if cache.exists():
        try: return json.loads(cache.read_text())
        except: pass
    try:
        html = _http_get("https://en.wikipedia.org/wiki/KOSPI_200")
        soup = BeautifulSoup(html,"html.parser")
        table = soup.find("table")
        df = pd.read_html(StringIO(str(table)))[0]
        for col in ["Ticker","Code","Symbol"]:
            if col in df.columns:
                syms = [ _norm_kr_code(x) for x in df[col].astype(str) ]
                cache.write_text(json.dumps(syms))
                return syms
    except Exception as e:
        logging.warning(f"KOSPI200 fetch fail: {e}")
    return []

# ===== 브레드스 =====
def breadth_last_series_batched(tickers, start=START, sma_win=SMA_WIN, batch=80):
    sum_above=sum_valid=None
    for i in range(0,len(tickers),batch):
        chunk=[t for t in tickers[i:i+batch] if t]
        if not chunk: continue
        try:
            px=yf.download(chunk, start=start, progress=False, group_by="ticker",
                           threads=False, auto_adjust=False, interval="1d")
        except Exception as e:
            logging.warning(f"yfinance chunk fail {i}: {e}"); continue
        # 종가 매트릭스
        if isinstance(px.columns, pd.MultiIndex):
            cols=[]
            for t in chunk:
                if t in px.columns.get_level_values(0):
                    sub=px[t]
                    s = sub.get("Adj Close") if "Adj Close" in sub else sub.get("Close")
                    if s is not None and not s.dropna().empty:
                        cols.append(s.rename(t))
            close = pd.concat(cols, axis=1) if cols else None
        else:
            close = px["Adj Close"].dropna(how="all") if "Adj Close" in px else \
                    (px["Close"].dropna(how="all") if "Close" in px else None)
        if close is None or close.empty: continue
        sma = close.rolling(sma_win, min_periods=sma_win//2).mean()
        last_close, last_sma = close.iloc[-1], sma.iloc[-1]
        above = (last_close>last_sma).astype("int32")
        valid = (~pd.isna(last_close)).astype("int32")
        sum_above = above if sum_above is None else sum_above.add(above, fill_value=0)
        sum_valid = valid if sum_valid is None else sum_valid.add(valid, fill_value=0)
    if sum_valid is None or sum_valid.sum()==0: return pd.Series(dtype="float64")
    return (sum_above/sum_valid).astype("float64")

# ===== 지수/ETF =====
def _pick_price(df, tk):
    if df is None or len(df)==0: return None
    try:
        if isinstance(df.columns, pd.MultiIndex) and tk in df.columns.get_level_values(0):
            sub=df[tk]
            s = sub.get("Adj Close") if "Adj Close" in sub else sub.get("Close")
            return s.rename(tk) if s is not None else None
        if "Adj Close" in df and tk in df["Adj Close"].columns: return df["Adj Close"][tk]
        if "Close"     in df and tk in df["Close"].columns:     return df["Close"][tk]
    except: pass
    return None

def safe_ratio_eqw_cap(eqw, cap, start=START):
    try:
        df=yf.download([eqw,cap], start=start, progress=False, group_by="ticker",
                       threads=False, auto_adjust=False, interval="1d")
        se, sc = _pick_price(df, eqw), _pick_price(df, cap)
        if se is None or sc is None: return pd.Series(dtype="float64")
        return (se/sc).dropna()
    except Exception as e:
        logging.warning(f"ratio fail: {e}")
        return pd.Series(dtype="float64")

def get_indices(start=START):
    out={}
    try:
        px=yf.download([KOSPI,KOSDAQ,VIX,US_EQW,US_CAP], start=start,
                       progress=False, threads=False, group_by="ticker",
                       auto_adjust=False, interval="1d")
    except Exception as e:
        logging.warning(f"indices download fail: {e}")
        px=None
    for tk in [KOSPI,KOSDAQ,VIX,US_EQW,US_CAP]:
        out[tk]=_pick_price(px, tk)
    return out

# ===== 리포트 =====
def _traffic(val, bad=None, good=None, invert=False):
    """간단 신호등: good 임계 이상이면 🟢, bad 이하면 🔴, 중간 🟡. invert=True면 방향 반전."""
    if val!=val or np.isnan(val): return "⚪"
    x = -val if invert else val
    if good is not None and x>=good: return "🟢"
    if bad  is not None and x<=bad:  return "🔴"
    return "🟡"

def build_report(now_utc: datetime):
    kst = timezone(timedelta(hours=9))
    ts = now_utc.astimezone(kst).strftime("%Y-%m-%d %H:%M KST")

    # 1) 광범위
    us_list = get_sp500_tickers(); kr_list = get_kospi200_tickers()
    us_b = breadth_last_series_batched(us_list, START, SMA_WIN) if us_list else pd.Series(dtype="float64")
    kr_b = breadth_last_series_batched(kr_list, START, SMA_WIN) if kr_list else pd.Series(dtype="float64")
    us_ratio = (us_b.sum()/len(us_b)) if len(us_b)>0 else np.nan
    kr_ratio = (kr_b.sum()/len(kr_b)) if len(kr_b)>0 else np.nan

    # 2) Equal vs Cap (4주)
    rsp_voo = safe_ratio_eqw_cap(US_EQW,US_CAP)
    kr_rc   = safe_ratio_eqw_cap(KR_EQW,KR_CAP)
    rsp_voo_4w = pct_change_4w(rsp_voo)
    kr_rc_4w   = pct_change_4w(kr_rc)

    # 3) 지수/변동성
    idx = get_indices()
    ks, kq, vx = idx[KOSPI], idx[KOSDAQ], idx[VIX]
    ks_4w = pct_change_4w(ks) if ks is not None else np.nan
    kq_4w = pct_change_4w(kq) if kq is not None else np.nan
    vx_4w = pct_change_4w(vx) if vx is not None else np.nan

    # 4) 금리/달러/원자재 (다중 소스)
    tnx = normalize_yield_pct(yf_close_series("^TNX"))
    tnx = first_non_empty(tnx, fred("DGS10"))          # %단위
    ust2 = normalize_yield_pct(yf_close_series("^UST2Y"))
    ust2 = first_non_empty(ust2, fred("DGS2"))
    dxy = first_non_empty(yf_close_series("DX-Y.NYB"), yf_close_series("DX=F"), fred("DTWEXBGS"))
    usdk = yf_close_series("KRW=X"); wti = yf_close_series("CL=F"); gold = yf_close_series("GC=F")

    tnx_ch, ust2_ch, dxy_ch = pct_change_4w(tnx), pct_change_4w(ust2), pct_change_4w(dxy)
    usdk_ch, wti_ch, gold_ch = pct_change_4w(usdk), pct_change_4w(wti), pct_change_4w(gold)

    # ===== 출력 =====
    L=[]
    L.append(f"[Market Monitor] {ts}\n")
    L.append("광범위 지표(200일선 상단 비율):")
    L.append(f"  · S&P500: { _pct(us_ratio) if us_ratio==us_ratio else 'N/A' } {_traffic(us_ratio, bad=0.4, good=0.6)}")
    L.append(f"  · KOSPI200: { _pct(kr_ratio) if kr_ratio==kr_ratio else 'N/A' } {_traffic(kr_ratio, bad=0.4, good=0.6)}\n")

    L.append("Equal vs Cap (4주 변화):")
    L.append(f"  · 미국 RSP/VOO: { _pct(rsp_voo_4w) if rsp_voo_4w==rsp_voo_4w else 'N/A' } {_traffic(rsp_voo_4w, bad=-0.03, good=0.03)}")
    L.append(f"  · 한국 KODEX200 Equal Weight / KODEX200 (252000/069500): { _pct(kr_rc_4w) if kr_rc_4w==kr_rc_4w else 'N/A' } {_traffic(kr_rc_4w, bad=-0.03, good=0.03)}\n")

    L.append("지수/변동성 (4주 변화):")
    L.append(f"  · KOSPI: { _pct(ks_4w) if ks_4w==ks_4w else 'N/A' } {_traffic(ks_4w, bad=-0.03, good=0.03)}")
    L.append(f"  · KOSDAQ: { _pct(kq_4w) if kq_4w==kq_4w else 'N/A' } {_traffic(kq_4w, bad=-0.03, good=0.03)}")
    L.append(f"  · VIX: { _pct(vx_4w) if vx_4w==vx_4w else 'N/A' } {_traffic(-vx_4w, bad=-0.03, good=0.03)}\n")  # 변동성은 역으로 해석

    sahm = fred("SAHMCURRENT"); t10y3m = fred("T10Y3M"); t10y2y = fred("T10Y2Y")
    hy = fred("BAMLH0A0HYM2"); bbb = fred("BAMLC0A4CBBB")
    sahm_last = sahm.iloc[-1] if not sahm.empty else np.nan
    t103_last = t10y3m.iloc[-1] if not t10y3m.empty else np.nan
    t102_last = t10y2y.iloc[-1] if not t10y2y.empty else np.nan
    hy_last = hy.iloc[-1] if not hy.empty else np.nan
    bbb_last = bbb.iloc[-1] if not bbb.empty else np.nan

    L.append("거시/경기 신호:")
    L.append(f"  · Sahm gap: { (f'{sahm_last:+.2f}pp') if sahm_last==sahm_last else 'N/A' } {_traffic(-sahm_last, bad=-0.5, good=0.0)}  (>= +0.50pp 시 침체 신호)")
    L.append(f"  · 장단기금리차 T10Y3M: { (f'{t103_last:.2f}%') if t103_last==t103_last else 'N/A' } {_traffic(t103_last, bad=-0.5, good=0.0)}")
    L.append(f"  · 장단기금리차 T10Y2Y: { (f'{t102_last:.2f}%') if t102_last==t102_last else 'N/A' } {_traffic(t102_last, bad=-0.5, good=0.0)}")
    L.append(f"  · HY OAS: { (f'{hy_last:.1f}bp') if hy_last==hy_last else 'N/A' } {_traffic(-hy_last, bad=-600, good=-300)}")
    L.append(f"  · BBB OAS: { (f'{bbb_last:.1f}bp') if bbb_last==bbb_last else 'N/A' } {_traffic(-bbb_last, bad=-300, good=-150)}\n")

    L.append("금리·달러·원자재 (최근값, 4주 변화):")
    L.append(f"  · UST 10Y: { (f'{tnx.iloc[-1]:.2f}%') if not tnx.empty else 'N/A' } ({ _pct(tnx_ch) if tnx_ch==tnx_ch else 'N/A' })")
    L.append(f"  · UST 2Y:  { (f'{ust2.iloc[-1]:.2f}%') if not ust2.empty else 'N/A' } ({ _pct(ust2_ch) if ust2_ch==ust2_ch else 'N/A' })")
    L.append(f"  · 달러지수(DXY/대체): { (f'{dxy.iloc[-1]:.2f}') if not dxy.empty else 'N/A' } ({ _pct(dxy_ch) if dxy_ch==dxy_ch else 'N/A' })")
    L.append(f"  · USD/KRW: { (f'{usdk.iloc[-1]:.2f}') if not usdk.empty else 'N/A' } ({ _pct(usdk_ch) if usdk_ch==usdk_ch else 'N/A' })")
    L.append(f"  · WTI(최근월): { (f'{wti.iloc[-1]:.2f}') if not wti.empty else 'N/A' } ({ _pct(wti_ch) if wti_ch==wti_ch else 'N/A' })")
    L.append(f"  · Gold(선물): { (f'{gold.iloc[-1]:.2f}') if not gold.empty else 'N/A' } ({ _pct(gold_ch) if gold_ch==gold_ch else 'N/A' })")
    return "\n".join(L).strip()

def send_notifications(text:str):
    try:
        smtp_host=os.environ.get("SMTP_HOST"); smtp_port=int(os.environ.get("SMTP_PORT","587"))
        smtp_user=os.environ.get("SMTP_USERNAME"); smtp_pass=os.environ.get("SMTP_PASSWORD")
        email_from=os.environ.get("EMAIL_FROM"); to=[x.strip() for x in os.environ.get("EMAIL_TO","").split(",") if x.strip()]
        if smtp_host and smtp_user and smtp_pass and email_from and to:
            import smtplib; from email.mime.text import MIMEText
            subj = f"[Market Monitor] {datetime.now(timezone.utc).astimezone(timezone(timedelta(hours=9))).strftime('%Y-%m-%d %H:%M KST')}"
            msg=MIMEText(text,_charset="utf-8"); msg["Subject"]=subj; msg["From"]=email_from; msg["To"]=", ".join(to)
            with smtplib.SMTP(smtp_host, smtp_port, timeout=20) as s:
                s.starttls(); s.login(smtp_user, smtp_pass); s.sendmail(email_from, to, msg.as_string())
    except Exception as e:
        logging.warning(f"Email send fail: {e}")
    try:
        bot=os.environ.get("TELEGRAM_BOT_TOKEN"); chat=os.environ.get("TELEGRAM_CHAT_ID")
        if bot and chat: requests.post(f"https://api.telegram.org/bot{bot}/sendMessage", data={"chat_id":chat,"text":text[:4096]}, timeout=10)
    except Exception as e:
        logging.warning(f"Telegram fail: {e}")

def run_monitor():
    text = build_report(datetime.now(timezone.utc))
    send_notifications(text)
    return text

if __name__=="__main__":
    print(run_monitor())
