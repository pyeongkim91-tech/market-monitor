# ---------- 기본 설정 ----------
START = "2019-01-01"
SMA_WIN = 200
W4 = 20  # 4주(영업일 약 20일)

US_EQW = "RSP"           # Invesco S&P 500 Equal Weight ETF
US_CAP = "VOO"           # Vanguard S&P 500 ETF
KR_EQW = "252000.KS"     # KODEX 200 Equal Weighted
KR_CAP = "069500.KS"     # KODEX 200
KOSPI  = "^KS11"
KOSDAQ = "^KQ11"
