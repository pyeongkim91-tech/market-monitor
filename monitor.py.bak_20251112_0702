# Market_Monitor_rebuild.py
import logging
from io import StringIO
from datetime import datetime, timezone, timedelta
from functools import lru_cache

import numpy as np
import pandas as pd
import requests
from bs4 import BeautifulSoup
import yfinance as yf
from pandas_datareader import data as pdr

# ---------------- 기본 설정 ----------------
START   = "2019-01-01"
SMA_WIN = 200
W4      = 20  # 4주(거래일수)
US_EQW, US_CAP = "RSP", "VOO"
KR_EQW, KR_CAP = "252000.KS", "069500.KS"
KOSPI, KOSDAQ  = "^KS11", "^KQ11"

logging.basicConfig(level=logging.INFO)

# ---------------- 유틸 ----------------
def s_ok(s):
    return isinstance(s, pd.Series) and not s.dropna().empty

def pct(x):
    try:
        return f"{x*100:.1f}%"
    except Exception:
        return "N/A"

def pct_change_weeks(s: pd.Series, weeks=W4):
    try:
        s = s.dropna()
        if len(s) <= weeks:
            return np.nan
        return s.iloc[-1] / s.iloc[-weeks] - 1.0
    except Exception:
        return np.nan

def traffic(val, mode="pos_good"):
    # mode="pos_good": 클수록 좋음, "neg_good": 작을수록 좋음
    if val != val or np.isnan(val):
        return "⚪"
    v = float(val)
    if mode == "pos_good":
        if v >= 0.05: return "🟢"
        if v >= 0.00: return "🟡"
        return "🔴"
    else:
        if v <= -0.05: return "🟢"
        if v <= 0.00:  return "🟡"
        return "🔴"

# ---------------- HTTP/위키 ----------------
def http_get(url: str) -> str:
    r = requests.get(
        url,
        timeout=15,
        headers={
            "User-Agent":"Mozilla/5.0",
            "Accept-Language":"en-US,en;q=0.9,ko;q=0.8",
        }
    )
    r.raise_for_status()
    return r.text

@lru_cache(maxsize=1)
def sp500_tickers():
    urls = [
        "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies",
        "https://en.wikipedia.org/wiki/List_of_S&P_500_companies",
    ]
    for url in urls:
        try:
            html = http_get(url)
            soup = BeautifulSoup(html, "html.parser")
            table = soup.find("table", {"id":"constituents"}) or soup.find("table")
            df = pd.read_html(StringIO(str(table)))[0]
            for col in ["Symbol","Ticker symbol"]:
                if col in df.columns:
                    syms = df[col].astype(str).str.strip().tolist()
                    return [s.replace(".","-") for s in syms if s]
        except Exception as e:
            logging.exception(f"sp500 list fail ({url}): {e}")
    return []

def _normalize_kr(s: str):
    if not isinstance(s, str): return s
    s = s.strip()
    if s.endswith(".KS") or s.endswith(".KQ"): return s
    if s.isdigit() and len(s)==6: return s + ".KS"
    return s

@lru_cache(maxsize=1)
def kospi200_tickers():
    try:
        html = http_get("https://en.wikipedia.org/wiki/KOSPI_200")
        soup = BeautifulSoup(html, "html.parser")
        table = soup.find("table")
        df = pd.read_html(StringIO(str(table)))[0]
        for col in ["Ticker","Code","Symbol"]:
            if col in df.columns:
                syms = [_normalize_kr(x) for x in df[col].astype(str).tolist()]
                return [x for x in syms if x]
    except Exception as e:
        logging.exception(f"kospi200 list fail: {e}")
    return []

# ---------------- yfinance 안전 취득 ----------------
def yf_download(tickers, start=START):
    try:
        return yf.download(tickers, start=start, progress=False,
                           group_by="ticker", threads=False, auto_adjust=False)
    except Exception as e:
        logging.exception(f"yfinance download failed: {e}")
        return pd.DataFrame()

def pick_close(df, tk):
    if df is None or df.empty: return None
    try:
        if isinstance(df.columns, pd.MultiIndex):
            if tk in df.columns.get_level_values(0):
                sub = df[tk]
                s = None
                if "Adj Close" in sub and not sub["Adj Close"].dropna().empty:
                    s = sub["Adj Close"]
                elif "Close" in sub and not sub["Close"].dropna().empty:
                    s = sub["Close"]
                return s.rename(tk) if s is not None else None
        else:
            # 단일 프레임
            if "Adj Close" in df and tk in df["Adj Close"]:
                return df["Adj Close"][tk].dropna().rename(tk)
            if "Close" in df and tk in df["Close"]:
                return df["Close"][tk].dropna().rename(tk)
    except Exception:
        pass
    return None

def yf_series(ticker, start=START):
    try:
        df = yf_download(ticker, start=start)
        if isinstance(df, pd.DataFrame):
            if "Adj Close" in df and isinstance(df["Adj Close"], pd.Series):
                return df["Adj Close"].dropna()
            if "Close" in df and isinstance(df["Close"], pd.Series):
                return df["Close"].dropna()
            # 멀티인덱스가 아닌 단일 시리즈 케이스
            for col in ["Adj Close","Close"]:
                if col in df.columns:
                    s = df[col]
                    if isinstance(s, pd.Series):
                        return s.dropna()
        return pick_close(df, ticker) or pd.Series(dtype="float64")
    except Exception as e:
        logging.exception(f"yf_series({ticker}) failed: {e}")
        return pd.Series(dtype="float64")

# ---------------- FRED ----------------
def fred(series_id, start=START):
    try:
        s = pdr.DataReader(series_id, "fred", start=start)
        if isinstance(s, pd.DataFrame) and s.shape[1] == 1:
            s = s.iloc[:,0]
        return s.dropna()
    except Exception as e:
        logging.exception(f"FRED {series_id} fail: {e}")
        return pd.Series(dtype="float64")

# ---------------- 지표 계산 ----------------
def breadth_last_snapshot_ratio(tickers):
    if not tickers: return np.nan
    ratio = pd.Series(dtype="float64")
    # 대량 배치 처리
    BATCH=80
    sum_above=None; sum_valid=None
    for i in range(0,len(tickers),BATCH):
        chunk = [t for t in tickers[i:i+BATCH] if t]
        if not chunk: continue
        px = yf_download(chunk, START)
        if px is None or px.empty: continue
        # 종가 매트릭스
        if isinstance(px.columns, pd.MultiIndex):
            cols=[]
            for t in chunk:
                if t in px.columns.get_level_values(0):
                    sub = px[t]
                    s=None
                    if "Adj Close" in sub and not sub["Adj Close"].dropna().empty:
                        s=sub["Adj Close"]
                    elif "Close" in sub and not sub["Close"].dropna().empty:
                        s=sub["Close"]
                    if s is not None:
                        cols.append(s.rename(t))
            close = pd.concat(cols,axis=1) if cols else None
        else:
            close = px["Adj Close"].dropna(how="all") if "Adj Close" in px else px.get("Close", pd.DataFrame()).dropna(how="all")
        if close is None or close.empty: continue

        sma = close.rolling(SMA_WIN, min_periods=SMA_WIN//2).mean()
        last_close = close.iloc[-1]
        last_sma   = sma.iloc[-1]
        above = (last_close > last_sma).astype("int32")
        valid = (~pd.isna(last_close)).astype("int32")
        sum_above = above if sum_above is None else sum_above.add(above, fill_value=0)
        sum_valid = valid if sum_valid is None else sum_valid.add(valid, fill_value=0)

    if sum_valid is None or sum_valid.sum()==0: return np.nan
    return float((sum_above / sum_valid).mean())

def eqw_cap_ratio(eqw, cap):
    df = yf_download([eqw, cap], START)
    s_eqw = pick_close(df, eqw)
    s_cap = pick_close(df, cap)
    if not s_ok(s_eqw) or not s_ok(s_cap): return pd.Series(dtype="float64")
    return (s_eqw / s_cap).dropna()

def get_dxy_series():
    # 1) ICE Dollar Index on NYBOT
    s = yf_series("DX-Y.NYB")
    if s_ok(s): return s, "달러지수(DXY)"
    # 2) 선물
    s = yf_series("DX=F")
    if s_ok(s): return s, "달러지수(DXY/선물)"
    # 3) FRED Broad Dollar Index
    s = fred("DTWEXBGS")
    if s_ok(s): return s, "달러지수(광의, FRED)"
    return pd.Series(dtype="float64"), "달러지수(N/A)"

def normalize_yield(s):
    # ^TNX,^IRX 등 10배 스케일 방지
    if s_ok(s) and s.iloc[-1] > 20.0:
        return s / 10.0
    return s

# ---------------- 리포트 ----------------
def build_report(now_utc: datetime):
    kst = timezone(timedelta(hours=9))
    ts  = now_utc.astimezone(kst).strftime("%Y-%m-%d %H:%M KST")

    # 1) Breadth
    spx = sp500_tickers()
    kr2 = kospi200_tickers()
    us_b = breadth_last_snapshot_ratio(spx) if spx else np.nan
    kr_b = breadth_last_snapshot_ratio(kr2) if kr2 else np.nan

    # fallback: 지수 자체 200MA 위/아래 (0/1)
    if np.isnan(us_b):
        spy = yf_series("SPY")
        if s_ok(spy):
            sma = spy.rolling(SMA_WIN, min_periods=SMA_WIN//2).mean()
            us_b = float(spy.iloc[-1] > sma.iloc[-1])
    if np.isnan(kr_b):
        ks = yf_series(KOSPI)
        if s_ok(ks):
            sma = ks.rolling(SMA_WIN, min_periods=SMA_WIN//2).mean()
            kr_b = float(ks.iloc[-1] > sma.iloc[-1])

    # 2) Equal vs Cap
    rsp_voo = eqw_cap_ratio(US_EQW, US_CAP)
    kr_eqw  = eqw_cap_ratio(KR_EQW, KR_CAP)
    rsp_4w  = pct_change_weeks(rsp_voo)
    kr_4w   = pct_change_weeks(kr_eqw)

    # 3) 지수/변동성
    ks11 = yf_series(KOSPI)
    kq11 = yf_series(KOSDAQ)
    vix  = yf_series("^VIX")
    if not s_ok(vix):
        vix = yf_series("VIXY")  # proxy
    ks_4w = pct_change_weeks(ks11)
    kq_4w = pct_change_weeks(kq11)
    vix_4w = pct_change_weeks(vix)

    # 4) 금리·달러·원자재
    t10 = normalize_yield(yf_series("^TNX"))
    t02 = normalize_yield(yf_series("^UST2Y"))  # 종종 실패
    if not s_ok(t02): t02 = normalize_yield(yf_series("^IRX"))  # T-bill proxy
    dxy, dxy_label = get_dxy_series()
    usdk = yf_series("KRW=X")
    wti  = yf_series("CL=F")
    gold = yf_series("GC=F")
    if not s_ok(gold): gold = yf_series("GLD")

    t10_ch  = pct_change_weeks(t10)
    t02_ch  = pct_change_weeks(t02)
    dxy_ch  = pct_change_weeks(dxy)
    usdk_ch = pct_change_weeks(usdk)
    wti_ch  = pct_change_weeks(wti)
    gold_ch = pct_change_weeks(gold)

    # 5) 거시/경기
    sahm  = fred("SAHMCURRENT")
    y3m10 = fred("T10Y3M")
    y2y10 = fred("T10Y2Y")
    hy    = fred("BAMLH0A0HYM2")
    bbb   = fred("BAMLC0A4CBBB")

    last = lambda s: s.dropna().iloc[-1] if s_ok(s) else np.nan

    lines=[]
    lines.append(f"[Market Monitor] {ts}\n")
    lines.append("광범위 지표(200일선 상단 비율):")
    lines.append(f"  · S&P500: { pct(us_b) if us_b==us_b else 'N/A' } {traffic(us_b)}")
    lines.append(f"  · KOSPI200: { pct(kr_b) if kr_b==kr_b else 'N/A' } {traffic(kr_b)}\n")

    lines.append("Equal vs Cap (4주 변화):")
    lines.append(f"  · 미국 RSP/VOO: { pct(rsp_4w) if rsp_4w==rsp_4w else 'N/A' } {traffic(rsp_4w,'pos_good')}")
    lines.append(f"  · 한국 KODEX200 Equal Weight / KODEX200 (252000/069500): { pct(kr_4w) if kr_4w==kr_4w else 'N/A' } {traffic(kr_4w,'pos_good')}\n")

    lines.append("지수/변동성 (4주 변화):")
    lines.append(f"  · KOSPI: { pct(ks_4w) if ks_4w==ks_4w else 'N/A' } {traffic(ks_4w)}")
    lines.append(f"  · KOSDAQ: { pct(kq_4w) if kq_4w==kq_4w else 'N/A' } {traffic(kq_4w)}")
    lines.append(f"  · VIX: { pct(vix_4w) if vix_4w==vix_4w else 'N/A' } {traffic(-vix_4w,'neg_good')}\n")

    lines.append("거시/경기 신호:")
    lines.append(f"  · Sahm gap: { (f'{last(sahm):+.2f}pp') if last(sahm)==last(sahm) else 'N/A' }  (>= +0.50pp 시 침체 신호)")
    lines.append(f"  · 장단기금리차 T10Y3M: { (f'{last(y3m10):.2f}%') if last(y3m10)==last(y3m10) else 'N/A' }")
    lines.append(f"  · 장단기금리차 T10Y2Y: { (f'{last(y2y10):.2f}%') if last(y2y10)==last(y2y10) else 'N/A' }")
    lines.append(f"  · HY OAS: { (f'{last(hy):.1f}bp') if last(hy)==last(hy) else 'N/A' }")
    lines.append(f"  · BBB OAS: { (f'{last(bbb):.1f}bp') if last(bbb)==last(bbb) else 'N/A' }\n")

    lines.append("금리·달러·원자재 (최근값, 4주 변화):")
    lines.append(f"  · UST 10Y: { (f'{last(t10):.2f}%') if last(t10)==last(t10) else 'N/A' } ({ pct(t10_ch) if t10_ch==t10_ch else 'N/A' })")
    lines.append(f"  · UST 2Y:  { (f'{last(t02)::.2f}%') if last(t02)==last(t02) else 'N/A' } ({ pct(t02_ch) if t02_ch==t02_ch else 'N/A' })")
    lines.append(f"  · {dxy_label}: { (f'{last(dxy):.2f}') if last(dxy)==last(dxy) else 'N/A' } ({ pct(dxy_ch) if dxy_ch==dxy_ch else 'N/A' })")
    lines.append(f"  · USD/KRW: { (f'{last(usdk):.2f}') if last(usdk)==last(usdk) else 'N/A' } ({ pct(usdk_ch) if usdk_ch==usdk_ch else 'N/A' })")
    lines.append(f"  · WTI(최근월): { (f'{last(wti):.2f}') if last(wti)==last(wti) else 'N/A' } ({ pct(wti_ch) if wti_ch==wti_ch else 'N/A' })")
    lines.append(f"  · Gold(선물/ETF): { (f'{last(gold):.2f}') if last(gold)==last(gold) else 'N/A' } ({ pct(gold_ch) if gold_ch==gold_ch else 'N/A' })")

    return "\n".join(lines)

def send_notifications(_): pass  # 기존 알림 로직은 app.py에서 그대로 사용
def run_monitor(): return build_report(datetime.now(timezone.utc))
if __name__ == "__main__":
    print(run_monitor())
